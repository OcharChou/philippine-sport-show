      s.parentNode.insertBefore(hm, s);
    })();
  </script>
</head>
<body id="pageTop">

<!-- NAVBAR -->
<nav id="mainNav">
  <a class="nav-logo" href="index.html">
    <img src="logo.jpg" alt="Philippine Sport Show 2026" onerror="this.style.display='none'">
    <span class="nav-logo-text">PSS <span>2026</span></span>
  </a>
  <ul class="nav-links" id="navLinks">
    <li><a href="index.html">Home</a></li>
    <li><a href="exhibitors.html" class="nav-current">Exhibitors</a></li>
    <li><a href="index.html#exhibit">Exhibit</a></li>
    <li><a href="index.html#visit">Visit</a></li>
    <li><a href="index.html#about">About</a></li>
    <li><a href="news.html">Market Insights</a></li>
    <li><a href="index.html#matchmaking" style="color:#60a5fa;">Matchmaking</a></li>
    <li><a href="registration.html" class="nav-cta">REGISTRATION</a></li>
  </ul>
  <div class="hamburger" id="hamburger" onclick="toggleNav()">
    <span></span><span></span><span></span>
  </div>
</nav>

<!-- DIRECTORY HERO -->
<header id="top">
  <div class="dir-inner">
    <div class="dir-badge">Sports Supplier Directory</div>
    <h1 class="dir-title">PSS 2026 EXHIBITORS &amp; SPORTS SUPPLIERS</h1>
    <p class="dir-desc">Discover sports brands, manufacturers, distributors and facility solution providers exhibiting at Philippine Sport Show 2026 in Manila.</p>
    <p class="dir-event">October 8&ndash;10, 2026 &nbsp;|&nbsp; SMX Convention Center Manila</p>
    <p class="dir-part">Part of Philippine Lifestyle Sourcing Expo 2026</p>
  </div>
</header>

<!-- DIRECTORY: SEARCH + FILTERS + RESULTS -->
<main id="directory">

  <!-- FIND A SPORTS SUPPLIER -->
  <div class="flt-block">
    <div class="flt-head">Find a Sports Supplier</div>
    <div class="search-wrap">
      <span class="s-icon">&#128269;</span>
      <input type="text" id="supSearch" placeholder="Search by company, product or keyword..." autocomplete="off" aria-label="Search suppliers by company, product or keyword">
    </div>
    <div class="pop-wrap">
      <div class="pop-label">Popular Sourcing</div>
      <div class="pop-chips">
        <button class="pop-chip" data-q="Pickleball Equipment" data-kw="pickleball">Pickleball Equipment</button><button class="pop-chip" data-q="Pickleball Court Flooring" data-kw="pickleball court flooring">Pickleball Court Flooring</button><button class="pop-chip" data-q="Sports Lighting" data-kw="sports lighting">Sports Lighting</button><button class="pop-chip" data-q="Basketball Products" data-kw="basketball">Basketball Products</button><button class="pop-chip" data-q="Sports Shoes" data-kw="sports shoes">Sports Shoes</button><button class="pop-chip" data-q="Sportswear" data-kw="sportswear">Sportswear</button><button class="pop-chip" data-q="Swimwear" data-kw="swimwear">Swimwear</button><button class="pop-chip" data-q="Fitness Products" data-kw="fitness">Fitness Products</button><button class="pop-chip" data-q="Sports Flooring" data-kw="sports flooring">Sports Flooring</button><button class="pop-chip" data-q="Outdoor Products" data-kw="outdoor">Outdoor Products</button>
      </div>
    </div>
  </div>

  <!-- FILTER BY SPORTS CATEGORY -->
  <div class="flt-block">
    <div class="flt-head">Filter by Sports Category</div>
    <div class="cat-btns" id="catBtns">
