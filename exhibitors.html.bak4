<!-- FLOATING BUTTONS -->
<div class="float-group">
  <a class="float-btn float-reg" href="registration.html" title="Registration">REG</a>
  <a class="float-btn float-top" href="#pageTop" title="Back to top">&#8593;</a>
</div>

<script>
  function toggleNav() {
    document.getElementById('navLinks').classList.toggle('open');
  }
  document.querySelectorAll('.nav-links a').forEach(function(link) {
    link.addEventListener('click', function() {
      document.getElementById('navLinks').classList.remove('open');
    });
  });
  var nav = document.getElementById('mainNav');
  window.addEventListener('scroll', function() {
    nav.style.background = window.scrollY > 60 ? 'rgba(26,5,51,0.98)' : 'rgba(26,5,51,0.92)';
  });

  /* ============ SUPPLIER DIRECTORY FILTERING ============
     Data lives in the static .sup-card elements (data-cats / data-apps / data-search).
     Cards are pre-sorted A-Z by company name; filtering only shows/hides, never reorders. */

  var cards = Array.prototype.slice.call(document.querySelectorAll('.sup-card'));
  var searchInput = document.getElementById('supSearch');
  var catBtns = Array.prototype.slice.call(document.querySelectorAll('#catBtns .flt-btn'));
  var appChips = Array.prototype.slice.call(document.querySelectorAll('#appChips .flt-chip'));
  var popChips = Array.prototype.slice.call(document.querySelectorAll('.pop-chip'));
  var resultBar = document.getElementById('resultBar');
  var clearBtn = document.getElementById('clearBtn');
  var noResults = document.getElementById('noResults');
  var state = { q: '', cat: 'all', app: '' };

  function norm(s) { return s.toLowerCase().replace(/-/g, ' ').replace(/\s+/g, ' ').trim(); }

  /* Popular Sourcing: friendly label -> stable search keyword (from data-kw) */
  function popKeyword(label) {
    var kw = '';
    popChips.forEach(function(p) {
      if (p.dataset.q === label) kw = p.dataset.kw || p.dataset.q;
    });
    return kw;
  }

  function catMatch(paramNorm) {
    var found = '';
    catBtns.forEach(function(b) {
      if (!b.dataset.cat || b.dataset.cat === 'all') return;
      var n = norm(b.dataset.cat);
      if (n === paramNorm || n.indexOf(paramNorm) === 0) found = b.dataset.cat;
    });
    return found;
  }

  function cardMatches(c) {
    if (state.cat !== 'all' && c.dataset.cats.split('|').indexOf(state.cat) === -1) return false;
    if (state.app && c.dataset.apps.split('|').indexOf(state.app) === -1) return false;
    if (state.q) {
      var words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
      var hay = ' ' + c.dataset.search.toLowerCase() + ' ';
      for (var i = 0; i < words.length; i++) {
        if (hay.indexOf(words[i]) === -1) return false;
      }
    }
    return true;
  }

  function apply() {
    var shown = 0;
    cards.forEach(function(c) {
      var ok = cardMatches(c);
      c.classList.toggle('hidden', !ok);
      if (ok) shown++;
    });
    noResults.classList.toggle('show', shown === 0);
    var filtered = !!(state.q || state.cat !== 'all' || state.app);
    resultBar.style.display = filtered ? 'flex' : 'none';
    /* sync URL params */
    if (window.history && window.history.replaceState) {
      var p = new URLSearchParams();
      if (state.q) p.set('search', state.q);
      if (state.cat !== 'all') p.set('category', state.cat);
      if (state.app) p.set('application', state.app);
      var qs = p.toString();
      history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));
    }
  }

  searchInput.addEventListener('input', function() { state.q = this.value.trim(); apply(); });

  catBtns.forEach(function(b) {
    b.addEventListener('click', function() {
      state.cat = this.dataset.cat;
      catBtns.forEach(function(x) { x.classList.toggle('active', x === b); });
      apply();
    });
  });

  appChips.forEach(function(ch) {
    ch.addEventListener('click', function() {
      var was = this.classList.contains('active');
      appChips.forEach(function(x) { x.classList.remove('active'); });
      if (!was) { this.classList.add('active'); state.app = this.dataset.app; }
      else { state.app = ''; }
      apply();
    });
  });

  /* popular sourcing shortcuts: search box shows the friendly label,
     filtering uses the stable mapped keyword from data-kw */
  popChips.forEach(function(p) {
    p.addEventListener('click', function() {
      searchInput.value = this.dataset.q;
      state.q = this.dataset.kw || this.dataset.q;
      apply();
      document.getElementById('directory').scrollIntoView({ behavior: 'smooth' });
    });
  });

  /* show more / less applications */
  var appMore = document.getElementById('appMore');
  var appWrap = document.getElementById('appChips');
  appMore.addEventListener('click', function() {
    var open = appWrap.classList.toggle('expanded');
    appMore.textContent = open ? 'Show Less \u2212' : 'Show More +';
  });

  function clearFilters() {
    state = { q: '', cat: 'all', app: '' };
    searchInput.value = '';
    catBtns.forEach(function(x) { x.classList.toggle('active', x.dataset.cat === 'all'); });
    appChips.forEach(function(x) { x.classList.remove('active'); });
    apply();
  }
  clearBtn.addEventListener('click', clearFilters);

  /* URL params: ?category= & ?search= & ?application= (links from homepage) */
  (function initFromUrl() {
    var p = new URLSearchParams(location.search);
    var catParam = p.get('category');
    var appParam = p.get('application');
    var qParam = p.get('search') || p.get('q');
    if (qParam) {
      searchInput.value = qParam;
      /* if the param is a Popular Sourcing label, use its stable keyword */
      state.q = popKeyword(qParam) || qParam;
    }
    if (catParam) {
      var m = catMatch(norm(catParam));
      if (m) {
        state.cat = m;
        catBtns.forEach(function(x) { x.classList.toggle('active', x.dataset.cat === m); });
      }
    }
    if (appParam) {
      var an = norm(appParam);
      appChips.forEach(function(ch) {
        if (norm(ch.dataset.app) === an) { ch.classList.add('active'); state.app = ch.dataset.app; }
      });
    }
    apply();
  })();
</script>
</body>
</html>
