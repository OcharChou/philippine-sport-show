<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PSS 2026 Exhibitors &amp; Sports Suppliers | Philippine Sport Show</title>
  <meta name="description" content="Explore Philippine Sport Show 2026 exhibitors and sports suppliers for pickleball, basketball, fitness, water sports, sports facilities, sports fashion and outdoor products. Meet suppliers at SMX Convention Center Manila, October 8–10, 2026." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.sportshow.com.ph/exhibitors" />
  <meta property="og:title" content="PSS 2026 Exhibitors &amp; Sports Suppliers | Philippine Sport Show" />
  <meta property="og:description" content="Discover sports brands, manufacturers, distributors and facility solution providers exhibiting at Philippine Sport Show 2026 in Manila." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.sportshow.com.ph/exhibitors" />
  <meta property="og:image" content="https://www.sportshow.com.ph/logo.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&family=Noto+Sans+SC:wght@400;600;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
