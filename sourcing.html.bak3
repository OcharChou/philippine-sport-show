</head>
<body id="pageTop">

<!-- NAVBAR -->
<nav id="mainNav">
  <a class="nav-logo" href="index.html">
    <img src="logo.jpg" alt="Philippine Sport Show 2026" onerror="this.style.display='none'">
    <span class="nav-logo-text">PSS <span>2026</span></span>
  </a>
  <ul class="nav-links" id="navLinks">
    <li><a href="index.html">Home</a></li>
    <li><a href="exhibitors.html">Exhibitors</a></li>
    <li><a href="sourcing.html" class="nav-current">Sourcing Connect</a></li>
