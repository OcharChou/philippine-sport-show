  <div class="hamburger" id="hamburger" onclick="toggleNav()">
    <span></span><span></span><span></span>
  </div>
</nav>

<!-- DIRECTORY HERO -->
<header id="top">
  <div class="dir-inner">
    <div class="dir-badge">Sports Sourcing Service</div>
    <h1 class="dir-title">PSS SOURCING CONNECT</h1>
    <p class="dir-sub">More Suppliers. More Choices.</p>
    <p class="dir-desc">Explore selected sports suppliers beyond the show floor.</p>
    <p class="dir-event">October 8&ndash;10, 2026 &nbsp;|&nbsp; SMX Convention Center Manila</p>
    <p class="dir-part">Philippine Sport Show (PSS) &mdash; a specialized sports section of Philippine Lifestyle Sourcing Expo (PHLSE)</p>
    <p class="dir-note">Sourcing Connect is an extended sourcing service of PSS. Listed suppliers are selected partners, not on-site exhibitors.</p>
  </div>
</header>

<!-- DIRECTORY: SEARCH + FILTERS + RESULTS -->
<main id="directory">

  <!-- FIND A SPORTS SUPPLIER -->
  <div class="flt-block">
    <div class="flt-head">Find a Sourcing Connect Supplier</div>
    <div class="search-wrap">
      <span class="s-icon">&#128269;</span>
      <input type="text" id="supSearch" placeholder="Search by company, product or keyword..." autocomplete="off" aria-label="Search suppliers by company, product or keyword">
    </div>
    <div class="pop-wrap">
      <div class="pop-label">Popular Sourcing</div>
      <div class="pop-chips">
        <button class="pop-chip" data-q="Pickleball Equipment" data-kw="pickleball">Pickleball Equipment</button><button class="pop-chip" data-q="Pickleball Court Flooring" data-kw="pickleball court flooring">Pickleball Court Flooring</button><button class="pop-chip" data-q="Sports Lighting" data-kw="sports lighting">Sports Lighting</button><button class="pop-chip" data-q="Basketball Products" data-kw="basketball">Basketball Products</button><button class="pop-chip" data-q="Sports Shoes" data-kw="sports shoes">Sports Shoes</button><button class="pop-chip" data-q="Sportswear" data-kw="sportswear">Sportswear</button><button class="pop-chip" data-q="Swimwear" data-kw="swimwear">Swimwear</button><button class="pop-chip" data-q="Fitness Products" data-kw="fitness">Fitness Products</button><button class="pop-chip" data-q="Sports Flooring" data-kw="sports flooring">Sports Flooring</button><button class="pop-chip" data-q="Outdoor Products" data-kw="outdoor">Outdoor Products</button>
      </div>
    </div>
  </div>

  <!-- FILTER BY SPORTS CATEGORY -->
  <div class="flt-block">
    <div class="flt-head">Filter by Sports Category</div>
    <div class="cat-btns" id="catBtns">
          <button class="flt-btn active" data-cat="all" data-norm="all">All Suppliers</button>
          <button class="flt-btn" data-cat="Sports Facilities" data-norm="sports facilities">Sports Facilities</button>
          <button class="flt-btn" data-cat="Fitness Equipment" data-norm="fitness equipment">Fitness Equipment</button>
          <button class="flt-btn" data-cat="Sports Bags" data-norm="sports bags">Sports Bags</button>
          <button class="flt-btn" data-cat="Pickleball &amp; Racket Sports" data-norm="pickleball &amp; racket sports">Pickleball &amp; Racket Sports</button>
          <button class="flt-btn" data-cat="Sportswear" data-norm="sportswear">Sportswear</button>
          <button class="flt-btn" data-cat="Sports Equipment" data-norm="sports equipment">Sports Equipment</button>
          <button class="flt-btn" data-cat="Outdoor &amp; Water Sports" data-norm="outdoor &amp; water sports">Outdoor &amp; Water Sports</button>
    </div>
  </div>

  <!-- RESULT BAR (Clear Filters appears only when a filter is active) -->
  <div class="result-bar" id="resultBar">
    <button id="clearBtn" type="button">Clear Filters</button>
  </div>

  <!-- SUPPLIER CARDS (static HTML for SEO / AI search readability) -->
